# DocSphere / ClinicOS Environment Configuration (Next.js 15 + Supabase PostgreSQL)
# Copy this file to .env.local and replace every [BRACKETED] value with a real secret.
# Never commit .env.local — it is gitignored.

# ─────────────────────────────────────────────────────────
# PostgreSQL Database (Supabase Pooler, AWS ap-south-1)
# ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[PROJECT-ID]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────
# Supabase Client
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"

# ─────────────────────────────────────────────────────────
# JWT Secret (HS256, 7-day expiry)
# Generate: openssl rand -hex 48
# ─────────────────────────────────────────────────────────
JWT_SECRET_KEY="[YOUR-SECURE-JWT-SECRET]"

# ─────────────────────────────────────────────────────────
# Groq API Key (AI Scribe / Consultant — optional)
# ─────────────────────────────────────────────────────────
GROQ_API_KEY="[YOUR-GROQ-API-KEY]"

# ─────────────────────────────────────────────────────────
# WhatsApp Cloud API (Meta) — Optional
# Leave BOTH empty to use free wa.me links (no cost, manual send).
# Set both to use Meta's WhatsApp Cloud API (costs per message — see Meta pricing).
# ─────────────────────────────────────────────────────────
WHATSAPP_TOKEN="[YOUR-WHATSAPP-CLOUD-API-TOKEN]"
WHATSAPP_PHONE_NUMBER_ID="[YOUR-WHATSAPP-PHONE-NUMBER-ID]"

# ─────────────────────────────────────────────────────────
# OTP Development Mode
# "true"  = log OTPs to console (free, no SMS cost) — recommended for dev
# "false" = send real WhatsApp/SMS (costs money)
# ─────────────────────────────────────────────────────────
OTP_DEV_MODE="true"

# ─────────────────────────────────────────────────────────
# Razorpay (Online Payments — optional)
# ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="[YOUR-RAZORPAY-KEY-ID]"
RAZORPAY_KEY_SECRET="[YOUR-RAZORPAY-KEY-SECRET]"

# ─────────────────────────────────────────────────────────
# App Base URL
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_APP_URL="https://medic-sept-2026.vercel.app"
