# DocSphere / ClinicOS Environment Configuration (Next.js 15 + Supabase PostgreSQL)

# PostgreSQL Database URL (Transaction Pooler port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres"

# Next.js App Base URL (leave empty for same-origin relative API calls in production)
NEXT_PUBLIC_API_URL=""

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"

# JWT & Razorpay Secrets
JWT_SECRET_KEY="[YOUR-SECURE-JWT-SECRET]"
RAZORPAY_KEY_ID="[YOUR-RAZORPAY-KEY-ID]"
RAZORPAY_KEY_SECRET="[YOUR-RAZORPAY-KEY-SECRET]"
