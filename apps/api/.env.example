# e.g. postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase API Keys (For Supabase Auth & Storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI Gateway (Optional: for smart clinical auto-complete & triage)
GEMINI_API_KEY=
