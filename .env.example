# ─────────────────────────────────────────────────────────────
# ClinicOS / DocSphere — environment template
# Copy to apps/web/.env.local for local development.
# NEVER commit real values. See .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase PostgreSQL, transaction pooler port 6543) ──
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres"

# Direct (non-pooled) connection — migrations only
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Auth ──
# HS256 signing key for staff sessions. Generate: openssl rand -base64 48
JWT_SECRET_KEY="[GENERATE-A-48-BYTE-RANDOM-SECRET]"
# Separate key for patient OTP sessions (never reuse the staff key)
PATIENT_JWT_SECRET="[GENERATE-A-SECOND-48-BYTE-RANDOM-SECRET]"

# ── Supabase client (browser) ──
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"
# Server-only. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"

# ── App URL ──
# Leave empty for same-origin relative API calls.
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Machine-to-machine secrets (webhooks / cron) ──
CRON_SECRET="[GENERATE-A-RANDOM-SECRET]"
WEBHOOK_SECRET="[GENERATE-A-RANDOM-SECRET]"
# Shared secret the lab analyzer/middleware presents as `x-lab-machine-secret`.
LAB_MACHINE_SECRET="[GENERATE-A-RANDOM-SECRET]"

# ── Payments (Razorpay) ──
RAZORPAY_KEY_ID="[YOUR-RAZORPAY-KEY-ID]"
RAZORPAY_KEY_SECRET="[YOUR-RAZORPAY-KEY-SECRET]"
RAZORPAY_WEBHOOK_SECRET="[YOUR-RAZORPAY-WEBHOOK-SECRET]"

# ── Notifications (OTP / reminders) ──
# WhatsApp Cloud API
WHATSAPP_TOKEN="[META-WHATSAPP-TOKEN]"
WHATSAPP_PHONE_NUMBER_ID="[PHONE-NUMBER-ID]"
WHATSAPP_VERIFY_TOKEN="[WEBHOOK-VERIFY-TOKEN]"
# Fallback SMS provider (optional)
SMS_PROVIDER_API_KEY="[SMS-KEY]"
SMS_SENDER_ID="[SENDER-ID]"

# ── AI ──
GROQ_API_KEY="[GROQ-API-KEY]"

# ── Runtime flags ──
# Console-print OTPs instead of sending them. Staging only — MUST be unset in production.
OTP_DEV_MODE="false"
